# ─── Configurações da Aplicação ──────────────────────────────────────────────
APP_PORT=3000
APP_ENV=development              # development | production (em produção JWT_SECRET é obrigatório)
# URL pública do app (usada no link do e-mail de recuperação de senha)
APP_BASE_URL=http://localhost:3000

# Aplica as migrations (goose embutido) ao subir. Use false para rodar à mão com a CLI do goose.
MIGRATE_ON_BOOT=true

# CORS: origens permitidas separadas por vírgula. Vazio = "*" em desenvolvimento e CORS desligado
# em produção (o front é servido pelo próprio backend, mesma origem).
CORS_ORIGINS=

# Limite de requisições por minuto/IP em login, cadastro, esqueci-senha e redefinir-senha (0 desativa)
RATE_LIMIT_MAX=10

# ─── Configurações do Banco de Dados MySQL ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=gymscore

# ─── Caminho do Frontend (servido como estático pelo backend) ────────────────
FRONTEND_PATH=../gymScore-frontend/public

# ─── Fotos de check-in (JPG/PNG/WEBP até 3 MB), servidas em /uploads ─────────
# Em produção use um volume persistente.
UPLOADS_DIR=uploads

# ─── Configurações de Autenticação JWT ───────────────────────────────────────
# IMPORTANTE: Altere este valor para uma chave secreta forte em produção
JWT_SECRET=gymscore_mude_esta_chave_em_producao_para_algo_seguro

# ─── Configurações Asaas (Gateway PIX) ──────────────────────────────────────
# >>> Para alternar entre testes e produção, mude SOMENTE esta linha: <<<
#     sandbox = ambiente de testes (QR fictício, dá pra simular pagamento)
#     prod    = produção (QR real, pagável em banco de verdade)
ASAAS_ENV=sandbox

# Chaves de cada ambiente (geradas no painel do Asaas em Integrações > Chaves de API).
# A URL base é escolhida automaticamente conforme o ASAAS_ENV acima:
#   sandbox -> https://api-sandbox.asaas.com
#   prod    -> https://api.asaas.com
ASAAS_API_KEY_SANDBOX=seu_token_sandbox_aqui
ASAAS_API_KEY_PROD=seu_token_producao_aqui

# Token do webhook do Asaas. VAZIO = rota /api/webhooks/asaas DESATIVADA (responde 404) — use
# assim quando não há URL pública; os pagamentos são confirmados por polling ativo na API do Asaas.
ASAAS_WEBHOOK_TOKEN=

# (Opcional) Sobrescreve a URL base do Asaas manualmente. Normalmente NÃO é
# necessário, pois ela é definida por ASAAS_ENV. O código já adiciona /v3 nos
# caminhos, então NÃO inclua /v3 aqui.
# ASAAS_BASE_URL=https://api-sandbox.asaas.com

# ─── Anthropic / Claude API ──────────────────────────────────────────────────
# Usada para gerar as razões textuais das recomendações de desafios.
# Se ficar vazia, o app continua funcionando normalmente com a heurística.
ANTHROPIC_API_KEY=sk-ant-...sua-chave-aqui...
# Modelo padrão: claude-haiku-4-5-20251001 (mais rápido/barato para razões curtas)
# Alternativas: claude-sonnet-4-5-20251022
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Recuperação de senha por e-mail (SMTP) ──────────────────────────────────
# Sem SMTP_HOST/SMTP_FROM o app entra em modo demo: o link de redefinição é escrito no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# (Opcional) Caminho alternativo do arquivo .env (útil em testes/CI)
# ENV_FILE=.env
