# ─── Configurações da Aplicação ──────────────────────────────────────────────
APP_PORT=3000
APP_ENV=development              # development | production (em produção JWT_SECRET é obrigatório)
# URL pública do app (usada no link do e-mail de recuperação de senha)
APP_BASE_URL=http://localhost:3000

# Aplica as migrations (goose embutido) ao subir. Use false para rodar à mão com a CLI do goose.
MIGRATE_ON_BOOT=true

# CORS: origens permitidas separadas por vírgula. Vazio = "*" em desenvolvimento e CORS desligado
# em produção (o front é servido pelo próprio backend, mesma origem).
CORS_ORIGINS=

# Limite de requisições por minuto/IP em login, cadastro, esqueci-senha e redefinir-senha (0 desativa)
RATE_LIMIT_MAX=10
# Limite (tentativas/min/IP) do login do painel admin. Independe de RATE_LIMIT_MAX e NÃO desliga:
# vazio, 0 ou negativo = 5.
ADMIN_LOGIN_RATE_LIMIT_MAX=5

# ─── Configurações do Banco de Dados MySQL ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=gymscore

# ─── Caminho do Frontend (servido como estático pelo backend) ────────────────
FRONTEND_PATH=../gymScore-frontend/public

# ─── Fotos de check-in (JPG/PNG/WEBP até 3 MB), servidas em /uploads ─────────
# Em produção use um volume persistente.
UPLOADS_DIR=uploads

# ─── Configurações de Autenticação JWT ───────────────────────────────────────
# Gere cada segredo com:  openssl rand -hex 32
# Em produção (APP_ENV=production) o servidor NÃO sobe se o segredo estiver vazio, tiver menos de
# 32 caracteres ou for um valor de exemplo publicado no repositório. Vazio em desenvolvimento usa
# um padrão inseguro só para rodar localmente.
JWT_SECRET=
# Segredo dos tokens do painel admin (/api/admin). Obrigatório em produção, >= 32 caracteres e
# diferente de JWT_SECRET (gere com: openssl rand -hex 32). Vazio em desenvolvimento usa um padrão de dev.
ADMIN_JWT_SECRET=
# Validade do login no painel admin (token e cookie `admin_jwt`). Duração Go (ex.: 8h, 30m); máx. 24h.
ADMIN_TOKEN_TTL=8h

# ─── Configurações Asaas (Gateway PIX) ──────────────────────────────────────
# >>> Para alternar entre testes e produção, mude SOMENTE esta linha: <<<
#     sandbox = ambiente de testes (QR fictício, dá pra simular pagamento)
#     prod    = produção (QR real, pagável em banco de verdade)
ASAAS_ENV=sandbox

# Chaves de cada ambiente (geradas no painel do Asaas em Integrações > Chaves de API).
# A URL base é escolhida automaticamente conforme o ASAAS_ENV acima:
#   sandbox -> https://api-sandbox.asaas.com
#   prod    -> https://api.asaas.com
ASAAS_API_KEY_SANDBOX=seu_token_sandbox_aqui
ASAAS_API_KEY_PROD=seu_token_producao_aqui

# Token do webhook do Asaas. VAZIO = rota /api/webhooks/asaas DESATIVADA (responde 404) — use
# assim quando não há URL pública; os pagamentos são confirmados por polling ativo na API do Asaas.
ASAAS_WEBHOOK_TOKEN=

# (Opcional) Sobrescreve a URL base do Asaas manualmente. Normalmente NÃO é
# necessário, pois ela é definida por ASAAS_ENV. O código já adiciona /v3 nos
# caminhos, então NÃO inclua /v3 aqui.
# ASAAS_BASE_URL=https://api-sandbox.asaas.com

# ─── Taxas da plataforma (lucro + custo do PIX/Asaas) ────────────────────────
# inscricao       = só a taxa sobre as inscrições dos desafios
# inscricao_saque = taxa sobre as inscrições + tarifa fixa debitada junto de cada saque
PLATAFORMA_TAXA_MODO=inscricao
# % das inscrições retido pela plataforma. Sai da parte da academia (o pote dos atletas nunca é reduzido).
# O valor é gravado no desafio na criação: mudar aqui não afeta desafios já criados.
PLATAFORMA_TAXA_INSCRICAO_PCT=10
# Tarifa de saque em centavos (200 = R$ 2,00). Só vale no modo inscricao_saque.
PLATAFORMA_TARIFA_SAQUE_CENTAVOS=200

# ─── Anthropic / Claude API ──────────────────────────────────────────────────
# Usada para gerar as razões textuais das recomendações de desafios.
# Se ficar vazia, o app continua funcionando normalmente com a heurística.
ANTHROPIC_API_KEY=sk-ant-...sua-chave-aqui...
# Modelo padrão: claude-haiku-4-5-20251001 (mais rápido/barato para razões curtas)
# Alternativas: claude-sonnet-4-5-20251022
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Recuperação de senha por e-mail (SMTP) ──────────────────────────────────
# Sem SMTP_HOST/SMTP_FROM o app entra em modo demo: o link de redefinição é escrito no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Jobs periódicos ─────────────────────────────────────────────────────────
# Intervalo (duração Go: 30s, 5m, 1h) do job que cancela desafios vencidos e reconcilia depósitos/saques
# PIX pendentes com o Asaas. 0 desativa os jobs. Seguro com várias instâncias.
JOBS_INTERVALO=5m
# Desafio aberto ou em andamento cuja data_evento + DESAFIO_CARENCIA passou sem pódio é cancelado
# automaticamente (entradas reembolsadas e reserva da academia devolvida).
DESAFIO_CARENCIA=48h

# ─── Moderação (denúncias, punições, recursos) ───────────────────────────────
# Prazo (horas, mínimo 1) da academia para julgar suborno de instrutor em desafio dela; vencido, o job
# escalonar-denuncias sobe a denúncia ao admin.
DENUNCIA_PRAZO_ACADEMIA_HORAS=72
# Denúncias por denunciante em 24h (acima: 429). 0 = sem limite (só fora de produção).
DENUNCIA_LIMITE_DIA=5
# Tamanho máximo de cada imagem de evidência (bytes; JPEG/PNG/WebP por magic bytes; até 3 por denúncia).
# Só a rota de upload aceita corpo acima de 1 MiB.
DENUNCIA_EVIDENCIA_MAX_BYTES=2097152
# Pasta PRIVADA das evidências (nunca servida estaticamente; não pode ser a UPLOADS_DIR). Fora do
# diretório público e com backup próprio: "nada é apagado".
EVIDENCIAS_DIR=evidencias
# Dias (contados do início da punição) para o punido recorrer.
RECURSO_PRAZO_DIAS=15
# Janela de contestação do pódio (horas): os créditos do pódio (prêmios, instrutor, academia e taxa da
# plataforma) ficam "a liberar" até podio_lancado_em + janela; o job liberar-pagamentos os credita depois.
# Denúncia de desafio aberta no período retém os pagamentos. 0 = libera no próximo ciclo (só fora de produção).
PREMIO_JANELA_CONTESTACAO_HORAS=48

# ─── Endereço da academia: consulta de CEP (GET /api/cep/:cep) ────────────────
# Base da API do ViaCEP (proxy com timeout de 3s e cache em memória). Só ajuda no preenchimento: o
# cadastro nunca depende dela. Padrão: https://viacep.com.br/ws
VIACEP_URL=https://viacep.com.br/ws
# Consultas de CEP por IP por minuto (rota pública; nunca desligada: <= 0 usa o padrão 30).
CEP_RATE_LIMIT_MAX=30

# (Opcional) Caminho alternativo do arquivo .env (útil em testes/CI)
# ENV_FILE=.env
