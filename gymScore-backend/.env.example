# ─── Configurações da Aplicação ──────────────────────────────────────────────
APP_PORT=3000
APP_ENV=development              # development | production

# ─── Configurações do Banco de Dados MySQL ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=gymscore

# ─── Caminho do Frontend (servido como estático pelo backend) ────────────────
FRONTEND_PATH=../gymScore-frontend/public

# ─── Configurações de Autenticação JWT ───────────────────────────────────────
# IMPORTANTE: Altere este valor para uma chave secreta forte em produção
JWT_SECRET=gymscore_mude_esta_chave_em_producao_para_algo_seguro

# ─── Configurações do PIX (Recebedor Sistema) ───────────────────────────────
PIX_CHAVE=sua-chave-pix-aqui@email.com
PIX_NOME_RECEBEDOR=GYMSCORE SISTEMA
PIX_CIDADE_RECEBEDOR=SAO PAULO

# ─── Configurações Asaas (Gateway PIX) ──────────────────────────────────────
# >>> Para alternar entre testes e produção, mude SOMENTE esta linha: <<<
#     sandbox = ambiente de testes (QR fictício, dá pra simular pagamento)
#     prod    = produção (QR real, pagável em banco de verdade)
ASAAS_ENV=sandbox

# Chaves de cada ambiente (geradas no painel do Asaas em Integrações > Chaves de API).
# A URL base é escolhida automaticamente conforme o ASAAS_ENV acima:
#   sandbox -> https://api-sandbox.asaas.com
#   prod    -> https://api.asaas.com
ASAAS_API_KEY_SANDBOX=seu_token_sandbox_aqui
ASAAS_API_KEY_PROD=seu_token_producao_aqui

# Token do webhook do Asaas (opcional). Deixe vazio para não validar o header
# — necessário quando não há URL pública para o webhook; nesse caso o app
# confirma os pagamentos por polling ativo na API do Asaas.
ASAAS_WEBHOOK_TOKEN=

# (Opcional) Sobrescreve a URL base do Asaas manualmente. Normalmente NÃO é
# necessário, pois ela é definida por ASAAS_ENV. O código já adiciona /v3 nos
# caminhos, então NÃO inclua /v3 aqui.
# ASAAS_BASE_URL=https://api-sandbox.asaas.com
